# Onglet Bot de ton application : Reset Token, puis copie-le ici.
DISCORD_TOKEN=

# Onglet General Information : Application ID.
DISCORD_CLIENT_ID=

# Facultatif mais recommande : l'ID de ton serveur Discord (clic droit sur le
# serveur > Copier l'identifiant, mode developpeur active).
# Rempli  -> /meme est dispo immediatement sur ce serveur.
# Vide    -> commande globale, jusqu'a une heure de propagation.
DISCORD_GUILD_ID=

# Temps d'affichage d'un meme a l'ecran, en millisecondes.
OVERLAY_DURATION_MS=8000

# Respiration entre deux memes : l'ecran est vide pendant ce temps-la.
OVERLAY_GAP_MS=500

# Volume des videos, de 0 (muet) a 1. Basculable en cours de soiree depuis
# l'icone dans la barre des taches.
OVERLAY_VOLUME=0.7

# Taille maximale de la file d'attente. Au-dela, les plus vieux en attente
# sont abandonnes plutot que de faire defiler pendant dix minutes.
QUEUE_MAX=40
