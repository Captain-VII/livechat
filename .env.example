# Onglet Bot de ton application : Reset Token, puis copie-le ici.
DISCORD_TOKEN=

# Onglet General Information : Application ID.
DISCORD_CLIENT_ID=

# Facultatif mais recommande : l'ID de ton serveur Discord (clic droit sur le
# serveur > Copier l'identifiant, mode developpeur active).
# Rempli  -> /meme est dispo immediatement sur ce serveur.
# Vide    -> commande globale, jusqu'a une heure de propagation.
DISCORD_GUILD_ID=

# Port de la page du mur.
PORT=3000

# Nombre de feuilles au mur. C'est aussi ce que voit quelqu'un qui arrive en
# cours de soiree : tous les ecrans montrent la meme chose.
HISTORY_SIZE=12

# Duree de vie d'un meme, en minutes. Passe ce delai, la feuille se decolle
# toute seule de tous les ecrans. 0 = pas de limite de temps (un meme reste
# jusqu'a ce que les suivants le poussent hors du mur).
MEME_TTL_MINUTES=30

# Delai minimum entre deux memes qui se collent au mur, en millisecondes.
# Une rafale de dix images ne repeint pas le mur d'un coup : elle defile.
MEME_INTERVAL_MS=1500

# Taille maximale de la file d'attente. Au-dela, les plus vieux en attente
# sont abandonnes plutot que de faire defiler pendant dix minutes.
QUEUE_MAX=40
