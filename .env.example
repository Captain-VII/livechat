# ============================================================================
# Reglages du SERVEUR (src/server.js) — a lancer sur la machine de l'hote.
# ============================================================================

# Onglet Bot de ton application : Reset Token, puis copie-le ici.
DISCORD_TOKEN=

# Onglet General Information : Application ID.
DISCORD_CLIENT_ID=

# Facultatif mais recommande : l'ID de ton serveur Discord (clic droit sur le
# serveur > Copier l'identifiant, mode developpeur active).
# Rempli  -> /meme est dispo immediatement sur ce serveur.
# Vide    -> commande globale, jusqu'a une heure de propagation.
DISCORD_GUILD_ID=

# Port sur lequel le serveur ecoute les overlays. C'est ce port que le tunnel
# (Cloudflare, ngrok) expose a tes potes.
PORT=8787

# 'cloudflare' (defaut) : un tunnel Cloudflare s'ouvre tout seul au demarrage,
# et son adresse est postee automatiquement dans Discord. 'none' : rien
# d'automatique, expose le port toi-meme (voir le README).
AUTO_TUNNEL=cloudflare

# Salon ou l'adresse est annoncee. Vide : le meme salon que celui qui recoit
# les memes.
ANNOUNCE_CHANNEL=

# Temps d'affichage d'un meme, en millisecondes.
OVERLAY_DURATION_MS=8000

# Respiration entre deux memes.
OVERLAY_GAP_MS=500

# Taille maximale de la file d'attente. Au-dela, les plus vieux en attente
# sont abandonnes plutot que de faire defiler pendant dix minutes.
QUEUE_MAX=40

# Delai laisse a Discord pour resoudre le lien d'un GIF du selecteur
# (Klipy, Tenor, Giphy). En dessous, le lien est laisse de cote.
EMBED_WAIT_MS=6000

# Duree maximale d'une video (voir plus bas 'Le rythme') : au-dela, elle est
# coupee plutot que de monopoliser le mur.
OVERLAY_VIDEO_MAX_MS=60000


# ============================================================================
# Reglages du CLIENT (src/client) — un fichier .env par ordinateur qui affiche
# l'overlay. Un ami sans terminal peut ignorer ce fichier entierement : la
# fenetre "Configurer le serveur" de l'icone suffit pour SERVER_URL.
# ============================================================================

# Adresse du serveur, telle que donnee par l'hote de la soiree.
# Local  -> SERVER_URL=ws://localhost:8787
# Tunnel -> SERVER_URL=wss://quelque-chose.trycloudflare.com
SERVER_URL=

# Sur quel ecran les memes apparaissent. Vide ou 'principal' : l'ecran principal.
# Sinon le numero affiche au demarrage dans la console (et dans le menu de la
# barre des taches), ou un bout du nom de l'ecran.
# Exemples : OVERLAY_DISPLAY=2   OVERLAY_DISPLAY=274QF   OVERLAY_DISPLAY=principal
OVERLAY_DISPLAY=principal

# Volume des videos, de 0 (muet) a 1. Basculable en cours de soiree depuis
# l'icone dans la barre des taches.
OVERLAY_VOLUME=0.7

# Sur quelle sortie audio le son des videos part. Vide ou 'defaut' : celle de
# Windows. Sinon un bout du nom du peripherique, tel qu affiche au demarrage
# dans la console.
# Exemples : OVERLAY_AUDIO_DEVICE=Music   OVERLAY_AUDIO_DEVICE=defaut
OVERLAY_AUDIO_DEVICE=defaut
