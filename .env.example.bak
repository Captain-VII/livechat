# Onglet Bot de ton application : Reset Token, puis copie-le ici.
DISCORD_TOKEN=

# Onglet General Information : Application ID.
DISCORD_CLIENT_ID=

# Facultatif mais recommande : l'ID de ton serveur Discord (clic droit sur le
# serveur > Copier l'identifiant, mode developpeur active).
# Rempli  -> /meme est dispo immediatement sur ce serveur.
# Vide    -> commande globale, jusqu'a une heure de propagation.
DISCORD_GUILD_ID=

# Port de la page du mur.
PORT=3000

# Nombre de memes gardes en memoire pour les retardataires.
HISTORY_SIZE=30
